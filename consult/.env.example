# Sandbox payment is for local/demo only. Real WeChat/Alipay should replace /api/orders/:id/pay.
PAYMENT_MODE=sandbox

# When true, payment success is recorded but Kuaishou is not called.
# Set false only after you have a real click callback from Kuaishou ads.
KUAISHOU_DRY_RUN=true

# Optional override. Official clue-conversion endpoint:
# https://ad.partner.gifshow.com/track/activate
KUAISHOU_ACTIVATE_URL=https://ad.partner.gifshow.com/track/activate

# Product
PRODUCT_PRICE=9.90
PRODUCT_LIST_PRICE=68.00
PRODUCT_NAME=澄室一对一情感咨询

PORT=8787
